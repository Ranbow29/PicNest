{
  "name": "picnest-workspace",
  "version": "1.0.1",
  "description": "PicNest 图巢 - 本地素材管理中心",
  "private": true,
  "type": "module",
  "scripts": {
    "build:ui": "npm --prefix ui run build",
    "dev:ui": "npm --prefix ui run dev",
    "patch": "node tools/patches/apply.mjs",
    "patch:exe": "node tools/patches/patch-exe-resources.mjs",
    "test:extension": "node tools/test-collect-script.mjs && node tools/test-collect-background.mjs",
    "test:extension:e2e": "node tools/e2e-extension.mjs",
    "test:rust": "cargo test --manifest-path ui/src-tauri/Cargo.toml --locked --lib",
    "test:updater": "cargo test --manifest-path ui/src-tauri/Cargo.toml --locked --lib updater::tests",
    "test:updater:rust": "cargo test --manifest-path ui/src-tauri/Cargo.toml --locked --lib updater::tests",
    "test:updater:legacy": "node tools/test-updater-e2e.mjs",
    "test:runtime-bridge": "node tools/test-runtime-bridge.mjs",
    "test:visual-search": "node tools/test-visual-search.mjs",
    "check:reliability": "npm run test:rust && npm run build:ui && npm run test:extension && npm run test:runtime-bridge && npm run test:visual-search && npm run test:updater && npm run test:extension:e2e",
    "build": "npm run build:ui"
  },
  "author": "Ranbow29",
  "license": "GPL-3.0"
}
