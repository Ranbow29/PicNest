{
  "name": "picnest-workspace",
  "version": "0.1.0",
  "description": "PicNest 图巢 - 本地素材管理中心",
  "private": true,
  "type": "module",
  "scripts": {
    "build:ui": "npm --prefix ui run build",
    "dev:ui": "npm --prefix ui run dev",
    "patch": "node tools/patches/apply.mjs",
    "patch:exe": "node tools/patches/patch-exe-resources.mjs",
    "test:extension": "node tools/test-collect-script.mjs && node tools/test-collect-background.mjs",
    "test:extension:e2e": "node tools/e2e-extension.mjs",
    "build": "npm run build:ui && npm run patch"
  },
